{
  "name": "next-inspect-ui-debug",
  "version": "0.3.0",
  "description": "Debug harness and compile-time stamps for next-inspect-ui. Development only.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gurvinder-Singh02/next-inspect-ui.git",
    "directory": "next-inspect-ui-debug"
  },
  "homepage": "https://github.com/Gurvinder-Singh02/next-inspect-ui/tree/main/next-inspect-ui-debug#readme",
  "bugs": {
    "url": "https://github.com/Gurvinder-Singh02/next-inspect-ui/issues"
  },
  "keywords": [
    "next",
    "nextjs",
    "inspector",
    "devtools"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js",
      "require": "./dist/inspect.cjs"
    },
    "./babel-stamp": {
      "types": "./dist/babel-stamp.d.ts",
      "import": "./dist/babel-stamp.js",
      "require": "./dist/babel-stamp.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "babel-loader": "^10.1.1",
    "next-inspect-ui": "workspace:^0.3.0"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
