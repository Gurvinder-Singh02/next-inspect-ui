{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Prefer the repo-root `.oxfmtrc.jsonc` when formatting from the monorepo.
  // This nested copy keeps `site/` consistent if formatted in isolation.
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css",
    "functions": ["cn", "cva"],
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".next/**",
    ".turbo/**",
    "coverage/**",
    "pnpm-lock.yaml",
    ".pnpm-store/**",
    "AGENTS.md",
  ],
}
