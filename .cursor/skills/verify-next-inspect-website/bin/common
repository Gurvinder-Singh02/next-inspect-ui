#!/usr/bin/env bash
# Shared paths and constants for verify-next-inspect-website helpers.
# Source this file; do not execute it.

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$BIN_DIR/.." && pwd)"
ROOT="$(git -C "$SKILL_DIR" rev-parse --show-toplevel)"
HOST="127.0.0.1"
PORT="4173"
URL="http://${HOST}:${PORT}"
RUN_DIR="$SKILL_DIR/.run"
PIDFILE="$RUN_DIR/pid"
LOGFILE="$RUN_DIR/server.log"
ARTIFACTS_DIR="$SKILL_DIR/artifacts"
DIST_DIR=".next-verify"
WEBSITE_DIR="$ROOT/next-inspect-website"
SESSION_PREFIX="verify-next-inspect-website"

port_listener_pid() {
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null |
    awk 'NR>1 { print $2; exit }'
}

http_code() {
  local path="${1:-/}"
  curl -sS -o /dev/null -w "%{http_code}" --max-time 3 "${URL}${path}" 2>/dev/null || true
}
