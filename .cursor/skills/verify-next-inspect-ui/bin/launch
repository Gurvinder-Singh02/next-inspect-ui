#!/usr/bin/env bash
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$SKILL_DIR"
while [[ "$REPO_ROOT" != "/" && ! -f "$REPO_ROOT/pnpm-workspace.yaml" ]]; do
  REPO_ROOT="$(cd "$REPO_ROOT/.." && pwd)"
done
RUN_DIR="$SKILL_DIR/.run"
HOST="${VERIFY_HOST:-127.0.0.1}"
PORT="${VERIFY_PORT:-4173}"
URL="http://${HOST}:${PORT}"

if [[ ! -f "$REPO_ROOT/pnpm-workspace.yaml" ]]; then
  echo "launch: expected pnpm-workspace.yaml at $REPO_ROOT" >&2
  exit 1
fi

mkdir -p "$RUN_DIR"

if [[ -f "$RUN_DIR/pid" ]]; then
  old_pid="$(cat "$RUN_DIR/pid")"
  if kill -0 "$old_pid" 2>/dev/null; then
    echo "launch: already running pid=$old_pid url=$(cat "$RUN_DIR/url" 2>/dev/null || true)" >&2
    echo "launch: run bin/cleanup first, or drive that instance after bin/doctor" >&2
    exit 1
  fi
  rm -f "$RUN_DIR/pid" "$RUN_DIR/url"
fi

if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "launch: port $PORT is already listening. Pick VERIFY_PORT or free it. Do not drive a server this helper did not start." >&2
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >&2 || true
  exit 1
fi

cd "$REPO_ROOT"

if [[ ! -d "$REPO_ROOT/node_modules" ]]; then
  pnpm install
fi

pnpm --filter next-inspect-ui build
pnpm --filter next-inspect-ui-debug build

: >"$RUN_DIR/server.log"

(
  cd "$REPO_ROOT/next-inspect-website"
  exec pnpm exec next dev --hostname "$HOST" --port "$PORT"
) >>"$RUN_DIR/server.log" 2>&1 &
pid=$!
echo "$pid" >"$RUN_DIR/pid"
echo "$URL" >"$RUN_DIR/url"
echo "$PORT" >"$RUN_DIR/port"
echo "$HOST" >"$RUN_DIR/host"

cleanup_failed_start() {
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  rm -f "$RUN_DIR/pid" "$RUN_DIR/url" "$RUN_DIR/port" "$RUN_DIR/host"
}

ready=0
for _ in $(seq 1 90); do
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "launch: next exited before ready. Last log:" >&2
    tail -n 40 "$RUN_DIR/server.log" >&2 || true
    cleanup_failed_start
    exit 1
  fi
  if curl -sf "$URL/test" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done

if [[ "$ready" != 1 ]]; then
  echo "launch: timed out waiting for $URL/test" >&2
  tail -n 40 "$RUN_DIR/server.log" >&2 || true
  cleanup_failed_start
  exit 1
fi

echo "VERIFY_URL=$URL"
echo "VERIFY_PID=$pid"
echo "VERIFY_LOG=$RUN_DIR/server.log"
