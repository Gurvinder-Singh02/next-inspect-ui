#!/usr/bin/env bash
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RUN_DIR="$SKILL_DIR/.run"

fail() {
  echo "doctor: FAIL $*" >&2
  exit 1
}

[[ -f "$RUN_DIR/pid" ]] || fail "no $RUN_DIR/pid (this helper never launched, or cleanup already ran)"
[[ -f "$RUN_DIR/url" ]] || fail "no $RUN_DIR/url"
[[ -f "$RUN_DIR/port" ]] || fail "no $RUN_DIR/port"

pid="$(cat "$RUN_DIR/pid")"
url="$(cat "$RUN_DIR/url")"
port="$(cat "$RUN_DIR/port")"

kill -0 "$pid" 2>/dev/null || fail "pid $pid is not alive"

collect_descendants() {
  local root="$1"
  local out="$root"
  local kids
  kids="$(pgrep -P "$root" 2>/dev/null || true)"
  local kid
  for kid in $kids; do
    out="$out $(collect_descendants "$kid")"
  done
  echo "$out"
}

tree="$(collect_descendants "$pid")"
listener="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | tr '\n' ' ')"
[[ -n "${listener// /}" ]] || fail "nothing listening on port $port"

owned=0
for lp in $listener; do
  for tp in $tree; do
    if [[ "$lp" == "$tp" ]]; then
      owned=1
      break
    fi
  done
done

if [[ "$owned" != 1 ]]; then
  fail "port $port is listening (pids: $listener) but not owned by launch pid $pid (tree: $tree). Refusing to drive a foreign instance."
fi

code_root="$(curl -s -o /dev/null -w '%{http_code}' "$url/")"
[[ "$code_root" == "200" ]] || fail "GET $url/ returned $code_root"

code_test="$(curl -s -o /dev/null -w '%{http_code}' "$url/test")"
[[ "$code_test" == "200" ]] || fail "GET $url/test returned $code_test (need the dev server; production 404s /test)"

echo "doctor: PASS"
echo "VERIFY_URL=$url"
echo "VERIFY_PID=$pid"
echo "VERIFY_PORT=$port"
echo "VERIFY_LISTENERS=$listener"
