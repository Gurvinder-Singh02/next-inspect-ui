{
  "name": "next-inspect-ui-monorepo",
  "private": true,
  "scripts": {
    "benchmark": "bun run build && node scripts/benchmark-inspectors.cjs",
    "format": "oxfmt --write -c .oxfmtrc.jsonc --disable-nested-config apps packages site '!**/dist/**' '!**/.next/**' '!**/node_modules/**' '!**/coverage/**' '!**/.turbo/**'",
    "fallow": "fallow dead-code",
    "fallow:audit": "fallow audit --base main",
    "fallow:baseline": "fallow dead-code --baseline fallow-baselines/dead-code.json",
    "dev": "pnpm --filter site dev",
    "dev:test": "bun run scripts/dev-tests.ts",
    "dev:example": "bun run dev:nextjs",
    "dev:lib": "pnpm --filter next-inspect-ui dev",
    "build": "pnpm --filter next-inspect-ui build",
    "build:site": "pnpm --filter next-inspect-ui build && pnpm --filter site build",
    "build:test": "bun run build:test-next-js",
    "build:example": "bun run build:nextjs",
    "test": "pnpm --filter @next-inspect-ui/test-cases test",
    "typecheck": "pnpm --filter next-inspect-ui typecheck && pnpm --filter @next-inspect-ui/test-cases typecheck && pnpm --filter site typecheck && pnpm --filter test-next-js typecheck && pnpm --filter nextjs typecheck",
    "dev:test-next-js": "bun run --cwd apps/test-next-js dev",
    "build:test-next-js": "bun run --cwd apps/test-next-js build",
    "dev:test-react-18": "bun run --cwd apps/test-react-18 dev",
    "build:test-react-18": "bun run --cwd apps/test-react-18 build",
    "typecheck:compat": "bun run --cwd apps/test-next-js typecheck && bun run --cwd apps/test-next-js-webpack typecheck && bun run --cwd apps/test-vite-react-19 typecheck && bun run --cwd apps/test-react-18 typecheck",
    "dev:nextjs": "bun run --cwd apps/nextjs dev",
    "build:nextjs": "bun run --cwd apps/nextjs build",
    "dev:test-next-js-webpack": "bun run --cwd apps/test-next-js-webpack dev",
    "build:test-next-js-webpack": "bun run --cwd apps/test-next-js-webpack build",
    "dev:test-vite-react-19": "bun run --cwd apps/test-vite-react-19 dev",
    "build:test-vite-react-19": "bun run --cwd apps/test-vite-react-19 build",
    "sync:test-ui": "bun run scripts/sync-test-ui.ts",
    "dev:bench": "bun run scripts/benchmark-checkout.ts dev",
    "benchmark:source": "bun run scripts/benchmark-checkout.ts source",
    "benchmark:open": "bun run scripts/benchmark-checkout.ts open"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "fallow": "^3.33.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.62.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "site"
  ]
}
