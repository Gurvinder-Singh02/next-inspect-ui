{
  "name": "next-inspect-ui-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter site dev",
    "dev:example": "pnpm --filter nextjs-example dev",
    "dev:test": "pnpm --filter next-js-test dev",
    "dev:lib": "pnpm --filter next-inspect-ui dev",
    "build": "pnpm --filter next-inspect-ui build",
    "build:site": "pnpm --filter site build",
    "build:example": "pnpm --filter nextjs-example build",
    "build:test": "pnpm --filter next-js-test build",
    "typecheck": "pnpm --filter next-inspect-ui typecheck && pnpm --filter site typecheck && pnpm --filter nextjs-example typecheck && pnpm --filter next-js-test typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
